# Copy to backend/.env for local development. Placeholders only — never commit real secrets.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sih:sih_dev_password@localhost:5432/sih_aicte
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetimes (minutes idle / hours absolute) and sign-in throttling
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
INVITATION_VALID_HOURS=72

# Development seed only (python -m app.seed). Choose your own; min. 12 characters.
SEED_PASSWORD=
