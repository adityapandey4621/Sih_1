# Copy to backend/.env for local development (and to ./.env next to docker-compose.yml for the Docker demo). Placeholders only - never commit real secrets.
# In production nothing here is used as written: see docs/DEPLOYMENT.md (secrets come from files, ENVIRONMENT=production refuses development values).

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sih:sih_dev_password@localhost:5432/sih_aicte
# Production: DATABASE_URL_FILE=/run/secrets/database_url   (a value set directly wins; an empty value counts as unset)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session lifetimes (minutes idle / hours absolute) and sign-in throttling
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
INVITATION_VALID_HOURS=72

# HTTP hardening. TRUSTED_PROXY_COUNT = number of reverse proxies that append to X-Forwarded-For (0 = the header is ignored; it is client-controllable).
TRUSTED_PROXY_COUNT=0
MAX_REQUEST_MB=64
RATE_LIMIT_ENABLED=true
RATE_LIMIT_READ_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=30

# Attachments: private directory (relative to backend/), size limit, and whether DEMO ONLY rules may be published/selected.
# ALLOW_DEMO_RULES is ignored (forced off) when ENVIRONMENT=production.
STORAGE_DIR=storage
MAX_UPLOAD_MB=10
ALLOW_DEMO_RULES=true

# Document processing (see docs/DOCUMENT_PROCESSING.md). OCR needs a Tesseract executable; without one, scanned pages are reported as unreadable.
OCR_ENGINE=tesseract
TESSERACT_CMD=
TESSDATA_PREFIX=
OCR_MIN_CONFIDENCE=70
# Malware scanning: SCANNER=clamd with CLAMD_HOST/CLAMD_PORT. Without a scanner files are labelled NOT scanned.
# REQUIRE_MALWARE_SCAN=true refuses files until a scanner exists (always on when ENVIRONMENT=production).
SCANNER=none
REQUIRE_MALWARE_SCAN=false

# Deadlines and alerts (docs/COMPLIANCE_AND_DEADLINES.md). Defaults are usually right.
SCHEDULER_POLL_SECONDS=5
SCHEDULER_SYNC_SECONDS=60
WORK_MAX_ATTEMPTS=5
WORK_LEASE_SECONDS=120
WORK_RETRY_BACKOFF_SECONDS=30
CLOCK_DUE_SOON_HOURS=72

# AICTE integration boundary (docs/INTEGRATION.md). No AICTE interface is known to exist: the default sends nothing.
#   none = nothing is sent (records say NOT_CONFIGURED)   mock = DEMO ONLY in-process adapter (refused in production)   http = this project's own contract, UNVERIFIED
AICTE_INTEGRATION_MODE=none
AICTE_BASE_URL=
# Secrets: prefer AICTE_API_KEY_FILE / AICTE_HMAC_SECRET_FILE (paths to files) over putting values here.
AICTE_API_KEY=
AICTE_HMAC_SECRET=
SYNC_MAX_ATTEMPTS=8
SYNC_RETRY_BACKOFF_SECONDS=60

# Development seed only (python -m app.seed). Choose your own; min. 12 characters. Never set in production.
SEED_PASSWORD=

# Docker demo only (docker-compose.prod.yml): the public host name that will be in front of the web container.
# SIH_PUBLIC_HOST=pace.example.org
